# Skopiuj ten plik jako .env i zmień wartości. Plik .env nie trafia do Git.
# Bez pliku .env działają wartości domyślne z docker-compose.yml (tylko do pracy lokalnej).

DB_PASSWORD=zmien_to_haslo_bazy
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=zmien_to_haslo_admina

# true: przy pierwszym starcie tworzy klienta demo klient@example.com / klient12345
DEMO_DATA=true

# true tylko za HTTPS (na serwerze produkcyjnym)
SESSION_COOKIE_SECURE=false
